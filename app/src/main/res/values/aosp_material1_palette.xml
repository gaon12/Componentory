        <item name="android:disabledAlpha">@dimen/aosp_material1_disabled_alpha_material_light</item>
        <item name="android:textColorPrimary">@color/aosp_material1_primary_text_material_light</item>
        <item name="android:textColorSecondary">@color/aosp_material1_secondary_text_material_light</item>
