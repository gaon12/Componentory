<?xml version="1.0" encoding="utf-8"?>
<!-- Adapted AOSP RatingBar resource bindings. The release styles use a 57dp height. -->
<resources>
    <style name="AospClassicRating" parent="@android:style/Widget.RatingBar">
        <item name="android:progressDrawable">@drawable/aosp_classic_ratingbar_full</item>
        <item name="android:indeterminateDrawable">@drawable/aosp_classic_ratingbar_full</item>
        <item name="android:indeterminateOnly">false</item>
        <item name="android:minHeight">57dp</item>
        <item name="android:maxHeight">57dp</item>
        <item name="android:thumb">@null</item>
    </style>
    <style name="AospHoloRating" parent="AospClassicRating">
        <item name="android:progressDrawable">@drawable/aosp_holo_ratingbar_full_holo_light</item>
        <item name="android:indeterminateDrawable">@drawable/aosp_holo_ratingbar_full_holo_light</item>
    </style>
    <style name="AospMaterial1Rating" parent="AospClassicRating">
        <item name="android:progressDrawable">@drawable/aosp_material1_ratingbar_full_material</item>
        <item name="android:indeterminateDrawable">@drawable/aosp_material1_ratingbar_full_material</item>
    </style>
    <item name="aosp_resource_revision" type="id" />
</resources>
